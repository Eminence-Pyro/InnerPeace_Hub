# Copy this file to .env and fill in your values
# Do NOT commit your actual .env file

SECRET_KEY=your-secret-key-here
FLASK_ENV=development

# Admin account password (used on first run to seed the admin user)
ADMIN_PASSWORD=your-admin-password-here

# Database (leave blank to use SQLite locally)
DATABASE_URL=postgresql://neondb_owner:<password>@ep-xxx.neon.tech/neondb?sslmode=require&channel_binding=require

# Cloudinary
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Newsletter (Gmail App Password — NOT your regular password)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-gmail@gmail.com
SMTP_PASS=your-gmail-app-password
SITE_URL=https://innerpeacehub.onrender.com

# Error Monitoring — Sentry (Improvement 13)
# Get your DSN at https://sentry.io (free tier available)
SENTRY_DSN=https://xxxx@oxxxx.ingest.sentry.io/xxxx
